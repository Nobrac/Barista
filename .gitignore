# The repositories bootstrap.bat fetches beside itself. They have their own
# history; this one is the workshop they get built in.
/Doppio/
/Ristretto/

# Build output
bin/
obj/
wizard-out/
TestResults/

# The self-contained exe bootstrap.bat copies to the root. Releases belong on
# the releases page, not in the history.
Barista.exe
*.user
*.suo

# Rider / VS
.vs/
.idea/

# Local NuGet restore
packages/
*.nuget.props
*.nuget.targets

# What tools\build-payload.ps1 writes: the compiled Doppio/Ristretto files and
# their manifest, embedded into Barista.exe by a release build. Built by CI
# from the pins in payload.lock.json, never committed.
payload/out/
payload/stage/
