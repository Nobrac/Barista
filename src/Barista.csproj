<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- The DLLs this tool installs are x64. Building the installer as AnyCPU
         would let it run as x86 on a 64-bit box, where registry writes get
         redirected into Wow6432Node and the install silently lands nowhere. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Barista</AssemblyName>
    <RootNamespace>Barista</RootNamespace>
    <Version>0.2.0</Version>
    <Company>The Admin Cafe</Company>
    <Product>Barista</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything that decides what happens to the machine lives here: the
         preflight checks, the stage plan, the stage runner, the pending-run
         record. Split out so it can be tested without a desktop - see
         core/Barista.Core.csproj. -->
    <ProjectReference Include="..\core\Barista.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Local QR rendering only. The point of this dependency is that nobody
         has to paste a TOTP secret into an online QR generator. MIT licensed,
         pure managed, no native bits. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- The built-in payload: Doppio and Ristretto, compiled by CI from the
       commits pinned in payload.lock.json, plus a manifest with the SHA-256 of
       every file. tools\build-payload.ps1 writes both into payload\out.

       Embedded only when present, so a plain "dotnet build" on a developer
       machine still works - that build simply has no payload and the wizard
       asks for folders instead. A release must not quietly become that build,
       hence RequirePayload, which the release workflow sets. -->
  <PropertyGroup>
    <PayloadDir>$(MSBuildThisFileDirectory)..\payload\out\</PayloadDir>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(PayloadDir)payload.zip') And Exists('$(PayloadDir)payload-manifest.json')">
    <EmbeddedResource Include="$(PayloadDir)payload.zip" LogicalName="Barista.Payload.zip" />
    <EmbeddedResource Include="$(PayloadDir)payload-manifest.json" LogicalName="Barista.Payload.json" />
  </ItemGroup>

  <Target Name="RequireEmbeddedPayload" BeforeTargets="BeforeBuild"
          Condition="'$(RequirePayload)' == 'true'">
    <Error Condition="!Exists('$(PayloadDir)payload.zip') Or !Exists('$(PayloadDir)payload-manifest.json')"
           Text="RequirePayload is set but $(PayloadDir) has no payload.zip and payload-manifest.json. Run tools\build-payload.ps1 first." />
  </Target>

</Project>
