<UserControl x:Class="Barista.Views.PreflightPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Grid Margin="0,0,0,6">
      <TextBlock Style="{StaticResource H1}" Text="What this machine looks like"/>
      <Button x:Name="RecheckButton" Content="Re-check" HorizontalAlignment="Right"
              VerticalAlignment="Top" Click="OnRecheck"/>
    </Grid>
    <TextBlock Style="{StaticResource Lede}">
      Read-only. Nothing below has been changed.
    </TextBlock>

    <TextBlock x:Name="BusyNote" Visibility="Collapsed" Margin="0,0,0,12"
               Foreground="{StaticResource Muted}"
               Text="Checking… reading the event log and the account list takes a moment."/>

    <ItemsControl x:Name="CheckList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{Binding Background}" BorderBrush="{Binding Accent}"
                  BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="15"
                         FontWeight="Bold" Foreground="{Binding Accent}"
                         Margin="0,0,12,0" VerticalAlignment="Top"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Detail}" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding Remedy}" Margin="0,6,0,0" FontSize="12"
                           Foreground="{StaticResource Muted}"
                           Visibility="{Binding RemedyVisibility}"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Border x:Name="PplCard" Style="{StaticResource CardBorder}"
            Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warning}"
            Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="RunAsPPL is on"/>
        <TextBlock Margin="0,6,0,12" MaxWidth="640">
          The LSA components cannot load while lsass is a protected process. Windows will not
          complain — the DLL is simply never loaded, and you spend an evening debugging code
          that never ran. This tool will not switch it off as part of an install step, because
          it is not a step. It is a lasting reduction in what protects the passwords on this
          machine, and it should be its own decision.
        </TextBlock>
        <Button Content="Turn RunAsPPL off (explain first)" HorizontalAlignment="Left"
                Style="{StaticResource DangerButton}" Click="OnDisablePpl"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
