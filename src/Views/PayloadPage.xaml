<UserControl x:Class="Barista.Views.PayloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="Hash" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="HashLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="Width" Value="62"/>
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="Built-in components"/>
    <TextBlock Style="{StaticResource Lede}">
      Everything this install puts on the machine is inside this program. Nothing is downloaded and
      nothing is compiled here. Before anything runs, the files are unpacked into a folder only
      administrators can change, and each one is read back and compared with the SHA-256 recorded
      when the release was built.
    </TextBlock>

    <!-- The verdict, first and large: this is the line people actually read. -->
    <Border x:Name="SummaryCard" CornerRadius="8" Padding="16" Margin="0,0,0,14"
            BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Card}"
            AutomationProperties.LiveSetting="Assertive">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,14,0">
          <Ellipse x:Name="SummaryDot" Fill="{StaticResource Muted}"/>
          <TextBlock x:Name="SummaryGlyph" Text="…" Foreground="White" FontSize="20"
                     FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextWrapping="NoWrap"/>
        </Grid>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="SummaryHeading" FontSize="15" FontWeight="SemiBold"
                     Text="Checking the built-in files…"/>
          <TextBlock x:Name="SummaryDetail" Margin="0,4,0,0" Foreground="{StaticResource Muted}"/>
          <ProgressBar x:Name="Progress" Height="6" Margin="0,10,0,0" Minimum="0"
                       Foreground="{StaticResource Coffee}" Background="{StaticResource Line}"
                       BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- The files, one row each: expected next to what is actually on disk. -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="SHA-256 comparison"/>
            <TextBlock x:Name="FilesCount" FontSize="12" Foreground="{StaticResource Muted}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="RecheckButton" Content="Check again" Click="OnRecheck" MinWidth="0"
                    Padding="12,6"/>
            <Button x:Name="CopyButton" Content="Copy report" Click="OnCopyReport" MinWidth="0"
                    Padding="12,6" Margin="8,0,0,0"/>
            <Button x:Name="OpenButton" Content="Open folder" Click="OnOpenFolder" MinWidth="0"
                    Padding="12,6" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>

        <ItemsControl x:Name="FileList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10"
                      AutomationProperties.Name="{Binding AccessibleName}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0" Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Ellipse Fill="{Binding Accent}"/>
                    <TextBlock Text="{Binding Glyph}" Foreground="White" FontSize="11"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  </Grid>

                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding Component}" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="8,1,0,0" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="8,1,0,0" TextWrapping="NoWrap"/>
                  </StackPanel>

                  <Border Grid.Row="0" Grid.Column="2" CornerRadius="10" Padding="10,2"
                          Background="{Binding PillBackground}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding Accent}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                  </Border>

                  <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                              Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource HashLabel}" Text="expected"/>
                    <TextBlock Style="{StaticResource Hash}" Text="{Binding Expected}"
                               ToolTip="{Binding Expected}"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                              Margin="0,2,0,0">
                    <TextBlock Style="{StaticResource HashLabel}" Text="on disk"/>
                    <TextBlock Style="{StaticResource Hash}" Text="{Binding Actual}"
                               Foreground="{Binding ActualBrush}" ToolTip="{Binding Actual}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="UnexpectedText" Margin="0,10,0,0" FontSize="12"
                   Foreground="{StaticResource Danger}" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <!-- Where the files came from. -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Built from"/>
        <TextBlock x:Name="BuiltFromNote" Margin="0,4,0,10" FontSize="12"
                   Foreground="{StaticResource Muted}"/>
        <ItemsControl x:Name="SourceList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Repository}" FontSize="12"
                             Foreground="{StaticResource Muted}"/>
                  <TextBox Text="{Binding Commit, Mode=OneWay}" IsReadOnly="True"
                           BorderThickness="0" Background="Transparent" Padding="0"
                           FontFamily="Consolas" FontSize="11.5"
                           AutomationProperties.Name="Commit"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- The exe itself: the half the manifest cannot vouch for. -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="This program"/>
        <TextBlock x:Name="SelfPath" Margin="0,4,0,8" FontSize="12"
                   Foreground="{StaticResource Muted}"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource HashLabel}" Text="SHA-256"/>
          <TextBox x:Name="SelfHash" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" FontFamily="Consolas" FontSize="11.5"
                   AutomationProperties.Name="SHA-256 of Barista.exe"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Ellipse x:Name="SignatureDot" Width="9" Height="9" Margin="0,0,8,0"
                   VerticalAlignment="Center" Fill="{StaticResource Muted}"/>
          <TextBlock x:Name="SignatureText" MaxWidth="600"/>
        </StackPanel>
        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Muted}">
          The comparison above shows the unpacked files are exactly the ones inside this program.
          Whether this program is the released one is what the signature and the SHA256SUMS file
          on the release page are for.
        </TextBlock>
      </StackPanel>
    </Border>

    <Border x:Name="RistrettoCard" Style="{StaticResource CardBorder}">
      <StackPanel>
        <CheckBox x:Name="ChkRistretto" Margin="0,0,0,6">
          <TextBlock FontWeight="SemiBold" Text="I also want to install Ristretto"/>
        </CheckBox>
        <TextBlock Margin="22,0,0,0" Foreground="{StaticResource Muted}" MaxWidth="600">
          Ristretto replaces Doppio's flat "no network logons for enrolled accounts" with a gate:
          prove a one-time code, get a short window during which SMB and WinRM work. It needs
          Doppio installed and at least one account enrolled first. Worth knowing before you tick
          this: the gate is opened on this machine, elevated, so it only helps if you already have
          console access here. It does nothing for a headless box or an unattended backup job.
        </TextBlock>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
