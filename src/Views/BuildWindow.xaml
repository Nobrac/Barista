<Window x:Class="Barista.Views.BuildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Build" Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Paper}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" x:Name="Heading" Style="{StaticResource H1}" FontSize="18"/>
    <TextBlock Grid.Row="1" x:Name="Subheading" Foreground="{StaticResource Muted}"
               Margin="0,0,0,14"/>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="8">
      <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
               FontFamily="Consolas" FontSize="11.5" Background="White"
               VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
               HorizontalScrollBarVisibility="Auto" Padding="12"/>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,16,0,0">
      <Button x:Name="StartButton" Content="Build" Style="{StaticResource PrimaryButton}"
              Click="OnStart" Margin="0,0,10,0"/>
      <Button x:Name="CloseButton" Content="Close" Click="OnClose"/>
    </StackPanel>
  </Grid>
</Window>
