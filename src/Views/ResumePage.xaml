<UserControl x:Class="Barista.Views.ResumePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource H1}" Text="Picking up after the restart"/>
    <TextBlock x:Name="Intro" Style="{StaticResource Lede}"/>

    <Border x:Name="VerifyCard" Style="{StaticResource CardBorder}"
            Background="{StaticResource WarnBg}" BorderBrush="{StaticResource Warning}">
      <StackPanel>
        <TextBlock x:Name="VerifyPrompt" FontWeight="SemiBold"/>
        <TextBlock x:Name="VerifyDetail" Margin="0,8,0,14" MaxWidth="640"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="YesButton" Content="Yes, it works — continue"
                  Style="{StaticResource PrimaryButton}" Click="OnConfirmed" Margin="0,0,10,0"/>
          <Button x:Name="NoButton" Content="No — stop here"
                  Style="{StaticResource DangerButton}" Click="OnFailed"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="RecoveryCard" Style="{StaticResource CardBorder}"
            Background="{StaticResource DangerBg}" BorderBrush="{StaticResource Danger}"
            Visibility="Collapsed">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Danger}"
                   Text="Stopped. Nothing further will run."/>
        <TextBlock x:Name="RecoveryText" Margin="0,8,0,14" MaxWidth="640"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Run the uninstall scripts" Click="OnUninstall" Margin="0,0,10,0"/>
          <Button Content="Forget this run" Click="OnForget"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Text="What is left"/>
        <ItemsControl x:Name="RemainingList" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontWeight="Bold"
                           Foreground="{Binding Accent}" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                             Foreground="{Binding Accent}"/>
                  <TextBlock Text="{Binding Note}" FontSize="12"
                             Foreground="{StaticResource Muted}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Expander Header="Log from before the restart" Margin="0,4,0,0">
      <TextBox x:Name="OldLog" IsReadOnly="True" BorderThickness="0" Height="200"
               FontFamily="Consolas" FontSize="11.5" Background="White" Margin="0,8,0,0"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
               Padding="12"/>
    </Expander>
  </StackPanel>
</UserControl>
